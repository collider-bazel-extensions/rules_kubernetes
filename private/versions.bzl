"""Kubernetes minor versions rules_kubernetes ships, and the default.

The envtest tarballs behind each version (and their SHA-256s) live in
//:extensions.bzl's _K8S_VERSIONS, generated by tools/update_checksums.sh.
"""

# Every version here needs a _K8S_VERSIONS entry, `k8s_<v>` targets in
# //:BUILD.bazel (generated from this list), and use_repo entries in
# MODULE.bazel.
SUPPORTED_VERSIONS = ["1.29", "1.35", "1.36", "1.37"]

# What `kubernetes_test` / `kubernetes_server` use when `k8s_version` is
# unset; //:k8s_default points here.
DEFAULT_VERSION = "1.35"

PLATFORMS = ["linux_amd64", "linux_arm64", "darwin_arm64", "darwin_amd64"]

def binary_label(k8s_version, rule_name):
    """Returns the //:k8s_<version> label for `k8s_version` (None → default).

    Args:
      k8s_version: Kubernetes minor version string (e.g. "1.35"), or None.
      rule_name: Calling rule/macro name, for the error message.

    Returns:
      Label of the kubernetes_binary target for that version.
    """
    if k8s_version == None:
        return Label("//:k8s_default")
    if k8s_version not in SUPPORTED_VERSIONS:
        fail("{}: unsupported k8s_version {}. Supported: {}".format(
            rule_name,
            repr(k8s_version),
            ", ".join(SUPPORTED_VERSIONS),
        ))
    return Label("//:k8s_" + k8s_version.replace(".", "_"))
