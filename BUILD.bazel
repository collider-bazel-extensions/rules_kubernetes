load("//private:binary.bzl", "kubernetes_binary", "kubernetes_binary_files")
load("//private:versions.bzl", "DEFAULT_VERSION", "PLATFORMS", "SUPPORTED_VERSIONS")

# ---------------------------------------------------------------------------
# Platform config_settings
# ---------------------------------------------------------------------------

config_setting(
    name = "_linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "_linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "_darwin_arm64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "_darwin_amd64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
)

# ---------------------------------------------------------------------------
# Per-version binary targets: k8s_<v> (e.g. :k8s_1_35), each a select() over
# the platform repos created by the kubernetes extension.
# ---------------------------------------------------------------------------

[
    kubernetes_binary_files(
        name       = "k8s_{}_{}_files".format(v.replace(".", "_"), p),
        bins       = ["@k8s_{}_{}//:all_files".format(v.replace(".", "_"), p)],
        version    = v,
        visibility = ["//visibility:private"],
    )
    for v in SUPPORTED_VERSIONS
    for p in PLATFORMS
]

[
    kubernetes_binary(
        name = "k8s_" + v.replace(".", "_"),
        binary = select({
            ":_" + p: ":k8s_{}_{}_files".format(v.replace(".", "_"), p)
            for p in PLATFORMS
        }),
        visibility = ["//visibility:public"],
    )
    for v in SUPPORTED_VERSIONS
]

# ---------------------------------------------------------------------------
# Default (private/versions.bzl DEFAULT_VERSION)
# ---------------------------------------------------------------------------

alias(
    name       = "k8s_default",
    actual     = ":k8s_" + DEFAULT_VERSION.replace(".", "_"),
    visibility = ["//visibility:public"],
)
